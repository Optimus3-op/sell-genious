# SellGenius AI Environment Configuration
# Runs out-of-the-box locally using Node's relational SQLite DB (data/sellgenius.db)
# and built-in analytics-grounded AI fallback when external keys are omitted.

# Session signing secret (set a strong random string in production)
AUTH_SECRET=sellgenius-local-dev-secret-change-in-production

# Optional: OpenAI API key for LLM-powered tool-calling AI Growth Advisor & Marketing Studio
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: Supabase PostgreSQL & Auth (for cloud deployment; see supabase/migrations/)
DATABASE_MODE=local
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Future payment gateway adapters (Sandbox Simulated Checkout is active in MVP)
STRIPE_SECRET_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
